{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/projects/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "handle": "filesystem" },
    {
      "src": "/(\\.well-known/.*|llms\\.txt|ai-catalog\\.json|ard\\.json|robots\\.txt|sitemap\\.xml|assets/.*|fonts/.*|projects/.*)",
      "status": 404
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
